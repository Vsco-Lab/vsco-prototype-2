<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="2" value="Agentic RAG 파이프라인" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
      <mxGeometry x="150" y="10" width="500" height="35" as="geometry"/>
    </mxCell>

    <!-- Row 1: 질의 → 질의 재작성 → 벡터 검색 -->
    <mxCell id="10" value="에이전트 질의" style="rounded=1;fillColor=#0077b6;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="40" y="70" width="160" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="20" value="질의 재작성&#xa;(LLM 최적화)" style="rounded=1;fillColor=#495057;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="280" y="70" width="160" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="30" value="벡터 검색&#xa;FAISS (상위 5개)" style="rounded=1;fillColor=#6c757d;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="520" y="70" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- Documents Box (왼쪽 아래) -->
    <mxCell id="90" value="" style="rounded=1;fillColor=#f0f4ff;strokeColor=#adb5bd;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
