    <!-- Output -->
    <mxCell id="80" value="섹션 결과물" style="rounded=1;fillColor=#1a1a2e;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="290" y="570" width="160" height="50" as="geometry"/>
    </mxCell>

    <!-- Bias Prevention Box (왼쪽 하단) -->
    <mxCell id="93" value="" style="rounded=1;fillColor=#fce4ec;strokeColor=#e57373;strokeWidth=1;arcSize=6;" vertex="1" parent="1">
      <mxGeometry x="40" y="440" width="330" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="94" value="편향 방지 전략" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#9b2226;" vertex="1" parent="1">
      <mxGeometry x="52" y="446" width="120" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="95" value="1. 양방향 검색 — 긍정/부정 쌍으로 실행&#xa;2. 교차 검증 — 상대 기업 관점에서 재확인&#xa;3. 균형 감사 — 긍/부정 비율 30~70% 검증" style="text;html=1;fontSize=10;fontStyle=0;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6c757d;" vertex="1" parent="1">
      <mxGeometry x="52" y="470" width="300" height="60" as="geometry"/>
    </mxCell>

    <!-- ===== EDGES ===== -->

    <!-- 질의 → 재작성 -->
    <mxCell id="300" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="10" target="20">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 재작성 → 벡터 검색 -->
    <mxCell id="310" style="endArrow=classic;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="20" target="30">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 벡터 검색 → 관련성 판단 -->
    <mxCell id="320" style="endArrow=classic;strokeColor=#333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="30" target="40">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 충분 → RAG 답변 -->
    <mxCell id="330" style="endArrow=classic;strokeColor=#28a745;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="40" target="50">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="331" value="충분" style="text;html=1;fontSize=10;fontStyle=1;fillColor=#d4edda;strokeColor=none;rounded=1;fontColor=#155724;" vertex="1" parent="1">
      <mxGeometry x="410" y="290" width="42" height="18" as="geometry"/>
    </mxCell>

    <!-- 부족 → 웹 검색 -->
    <mxCell id="340" style="endArrow=classic;strokeColor=#dc3545;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="40" target="60">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="710" y="220"/>
          <mxPoint x="710" y="340"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="341" value="부족" style="text;html=1;fontSize=10;fontStyle=1;fillColor=#fce4ec;strokeColor=none;rounded=1;fontColor=#9b2226;" vertex="1" parent="1">
      <mxGeometry x="715" y="270" width="35" height="18" as="geometry"/>
    </mxCell>

    <!-- RAG 답변 → 결과물 -->
    <mxCell id="350" style="endArrow=classic;strokeColor=#2d6a4f;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="50" target="80">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 웹 검색 → 통합 답변 -->
    <mxCell id="360" style="endArrow=classic;strokeColor=#e85d04;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="60" target="70">
