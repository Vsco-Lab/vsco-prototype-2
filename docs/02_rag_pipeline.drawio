    <!-- 통합 답변 → 결과물 -->
    <mxCell id="370" style="endArrow=classic;strokeColor=#2d6a4f;strokeWidth=2;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;curved=1;" edge="1" parent="1" source="70" target="80">
