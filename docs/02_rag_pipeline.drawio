    <mxCell id="91" value="RAG 문서 (5개 파일, ~95쪽)" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#495057;" vertex="1" parent="1">
      <mxGeometry x="52" y="176" width="250" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="92" value="01 시장 환경 | 02 LG에너지솔루션 | 03 CATL&#xa;04 비교 데이터 | 05 리스크·외부 환경" style="text;html=1;fontSize=10;fontStyle=0;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#6c757d;" vertex="1" parent="1">
      <mxGeometry x="52" y="200" width="310" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="96" value="임베딩: multilingual-e5-large (오픈소스)&#xa;청크: 1,000자 / 오버랩: 200자" style="text;html=1;fontSize=9;fontStyle=2;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="52" y="235" width="300" height="25" as="geometry"/>
    </mxCell>

    <!-- Relevance Check (오른쪽) -->
    <mxCell id="40" value="관련성&#xa;충분한가?" style="rhombus;fillColor=#fff3cd;strokeColor=#ffc107;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#856404;" vertex="1" parent="1">
      <mxGeometry x="520" y="185" width="140" height="70" as="geometry"/>
    </mxCell>

    <!-- YES path (왼쪽으로) -->
    <mxCell id="50" value="답변 생성&#xa;(RAG 결과만 사용)" style="rounded=1;fillColor=#2d6a4f;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="120" y="340" width="200" height="50" as="geometry"/>
    </mxCell>

    <!-- NO path (오른쪽으로) -->
    <mxCell id="60" value="웹 검색 보완&#xa;(Serper.dev)" style="rounded=1;fillColor=#e85d04;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="500" y="340" width="180" height="50" as="geometry"/>
    </mxCell>

    <!-- Merge -->
    <mxCell id="70" value="답변 생성&#xa;(RAG + 웹 결과 통합)" style="rounded=1;fillColor=#2d6a4f;strokeColor=none;fontColor=#ffffff;fontSize=12;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="480" y="460" width="210" height="50" as="geometry"/>
