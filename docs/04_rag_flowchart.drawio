<mxGraphModel>
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="2" value="Agentic RAG 흐름도" style="text;html=1;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#1a1a2e;" vertex="1" parent="1">
      <mxGeometry x="200" y="10" width="400" height="35" as="geometry"/>
    </mxCell>

    <!-- 1. 에이전트 질의 -->
    <mxCell id="10" value="에이전트 질의" style="rounded=1;fillColor=#0077b6;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="60" width="180" height="45" as="geometry"/>
    </mxCell>

    <!-- 2. 질의 재작성 -->
    <mxCell id="20" value="질의 재작성 (LLM)" style="rounded=1;fillColor=#495057;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="140" width="180" height="45" as="geometry"/>
    </mxCell>

    <!-- 3. FAISS 검색 -->
    <mxCell id="30" value="FAISS 검색 (상위 5개)" style="rounded=1;fillColor=#6c757d;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="220" width="180" height="45" as="geometry"/>
    </mxCell>

    <!-- 4. 관련성 판단 -->
    <mxCell id="40" value="관련성 판단&#xa;(LLM)" style="rhombus;fillColor=#fff3cd;strokeColor=#ffc107;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#856404;" vertex="1" parent="1">
      <mxGeometry x="330" y="310" width="140" height="80" as="geometry"/>
    </mxCell>

    <!-- 5a. 충분 → 답변 생성 (RAG) -->
    <mxCell id="50" value="답변 생성" style="rounded=1;fillColor=#2d6a4f;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="100" y="440" width="160" height="45" as="geometry"/>
    </mxCell>

    <!-- 5b. 부족 → 웹 검색 보완 -->
    <mxCell id="60" value="웹 검색 보완&#xa;(Serper.dev)" style="rounded=1;fillColor=#e85d04;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="530" y="440" width="180" height="45" as="geometry"/>
    </mxCell>

    <!-- 6. RAG + 웹 결과 통합 -->
    <mxCell id="70" value="RAG + 웹 결과 통합" style="rounded=1;fillColor=#495057;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="530" y="530" width="180" height="45" as="geometry"/>
    </mxCell>

    <!-- 7. 답변 생성 (통합) -->
    <mxCell id="75" value="답변 생성" style="rounded=1;fillColor=#2d6a4f;strokeColor=none;fontColor=#ffffff;fontSize=13;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="530" y="620" width="180" height="45" as="geometry"/>
    </mxCell>

    <!-- 8. 섹션 결과물 (합류) -->
    <mxCell id="80" value="섹션 결과물" style="rounded=1;fillColor=#1a1a2e;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1">
      <mxGeometry x="310" y="720" width="180" height="50" as="geometry"/>
    </mxCell>

    <!-- ===== EDGES ===== -->

    <!-- 질의 → 재작성 -->
    <mxCell id="300" style="endArrow=classic;strokeColor=#333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="10" target="20">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 재작성 → FAISS -->
    <mxCell id="310" style="endArrow=classic;strokeColor=#333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="20" target="30">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- FAISS → 관련성 판단 -->
    <mxCell id="320" style="endArrow=classic;strokeColor=#333;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="30" target="40">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 충분 → 답변 생성 (왼쪽) -->
    <mxCell id="330" style="endArrow=classic;strokeColor=#28a745;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="40" target="50">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="180" y="350"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="331" value="충분" style="text;html=1;fontSize=11;fontStyle=1;fillColor=#d4edda;strokeColor=none;rounded=1;fontColor=#155724;" vertex="1" parent="1">
      <mxGeometry x="220" y="338" width="45" height="20" as="geometry"/>
    </mxCell>

    <!-- 부족 → 웹 검색 (오른쪽) -->
    <mxCell id="340" style="endArrow=classic;strokeColor=#dc3545;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="40" target="60">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="620" y="350"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="341" value="부족" style="text;html=1;fontSize=11;fontStyle=1;fillColor=#fce4ec;strokeColor=none;rounded=1;fontColor=#9b2226;" vertex="1" parent="1">
      <mxGeometry x="530" y="338" width="45" height="20" as="geometry"/>
    </mxCell>

    <!-- 답변 생성(RAG) → 섹션 결과물 -->
    <mxCell id="350" style="endArrow=classic;strokeColor=#2d6a4f;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="50" target="80">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="180" y="745"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- 웹 검색 → 통합 -->
    <mxCell id="360" style="endArrow=classic;strokeColor=#e85d04;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="60" target="70">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 통합 → 답변 생성 -->
    <mxCell id="370" style="endArrow=classic;strokeColor=#495057;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="70" target="75">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- 답변 생성(통합) → 섹션 결과물 -->
    <mxCell id="380" style="endArrow=classic;strokeColor=#2d6a4f;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="75" target="80">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="620" y="745"/>
        </Array>
      </mxGeometry>
    </mxCell>

  </root>
</mxGraphModel>